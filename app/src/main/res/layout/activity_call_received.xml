<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_incoming_call_screen"
    >




    <!-- ===== Caller avatar + name + subtitle ===== -->
    <LinearLayout
        android:id="@+id/caller_info_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="68dp">

        <TextView
            android:id="@+id/call_avatar"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="M"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary" />

        <TextView
            android:id="@+id/call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Mom"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Chronometer
                android:id="@+id/call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="00:00"
                android:textSize="14sp"
                android:textColor="@color/text_gray" />
        </LinearLayout>

    </LinearLayout>















    <!-- ===== Decline button ===== -->
    <TextView
        android:id="@+id/btn_decline_received"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="58dp"
        android:background="@drawable/bg_button_decline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />




















    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tool_card"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btn_decline_received"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="60dp"
        android:layout_marginStart="60dp"
        android:paddingVertical="10dp"
        android:paddingHorizontal="2dp"
        >


        <!-- 1st -->



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingVertical="8dp"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="10dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_plus"
                    android:padding="14dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Call"
                    android:textColor="@color/text_gray"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    />


            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_hold"
                    android:padding="14dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hold"
                    android:textColor="@color/text_gray"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    />



            </LinearLayout>



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                android:layout_marginStart="10dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_bluetooth"
                    android:padding="14dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth"
                    android:textColor="@color/text_gray"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    />



            </LinearLayout>





        </LinearLayout>




















        <!-- 2nd -->




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:paddingVertical="8dp"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                android:layout_marginEnd="10dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_speaker"
                    android:padding="14dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speaker"
                    android:textColor="@color/text_gray"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    />


            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_mute"
                    android:padding="14dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="13dp"
                    android:layout_marginTop="5dp"
                    android:text="mute"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"/>



            </LinearLayout>



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingHorizontal="18dp"
                android:layout_marginStart="10dp"
                >

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/received_avatar_circle"
                    android:src="@drawable/ic_keypad"
                    android:padding="15dp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keypad"
                    android:textColor="@color/text_gray"
                    android:layout_marginTop="5dp"
                    android:textSize="12sp"
                    />



            </LinearLayout>





        </LinearLayout>









    </LinearLayout>









</androidx.constraintlayout.widget.ConstraintLayout>